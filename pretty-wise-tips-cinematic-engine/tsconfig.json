{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["src", "scripts", "tests", "remotion.config.ts"]
}
