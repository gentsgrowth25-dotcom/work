{
  "name": "pretty-wise-tips-cinematic-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable native 4:5 cel-art cinematic engine with illustrated pilot, original narration and a reviewed rendering pipeline.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx scripts/validate-production.ts",
    "validate:development": "tsx scripts/validate.ts",
    "build": "remotion bundle src/index.ts build",
    "render": "tsx scripts/render.ts",
    "render:silent": "tsx scripts/render.ts --silent",
    "render:production": "tsx scripts/render.ts --composition final",
    "render:test": "tsx scripts/render.ts --composition test",
    "render:development": "tsx scripts/render.ts --composition development",
    "still": "tsx scripts/render.ts --still",
    "audio:inspect": "node scripts/import-audio.mjs",
    "test:render": "tsx tests/render-smoke.ts",
    "test:studio": "tsx tests/studio-preview.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
